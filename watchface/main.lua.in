local screens={main=main,menu=menu,control=control,events=events_screen,agenda=agenda}
local history={"main"}
local function open(name)
    show(screens[history[#history]],false)
    history[#history+1]=name
    show(screens[name],true)
end
local function close()
    if #history<2 then return end
    show(screens[table.remove(history)],false)
    show(screens[history[#history]],true)
end
for name,object in pairs(screens) do show(object,name=="main") end

-- nil until dataman delivers the time, which happens after the face script has run
local function now()
    return clock.hour and clock.minute and string.format("%02d:%02d",clock.hour,clock.minute)
end
local function render()
    local color=FM_COLOR[fm.state]
    pill:set{border_color=color}
    pill_dot:set{bg_color=color}
    menu_fm_value:set{text=({on="ON",off="OFF",err="ERR"})[fm.state],text_color=color}
    fm_big:set{text=({on="ON AIR",off="OFF",err="FAILED"})[fm.state],text_color=color}
    fm_detail:set{text=(fm.state=="err" and "failed " or "since ")..((fm.state=="err" and fm.time or fm.since) or "--:--")}
    toggle:set{bg_color=fm.state=="on" and C.stop or C.start}
    toggle_text:set{text=fm.state=="on" and "STOP" or "START"}
    auto_track:set{bg_color=fm.auto and C.start or C.track}
    auto_knob:set{x=fm.auto and 23 or 3}
    last_text:set{text=(fm.ok and "OK " or "FAILED ")..(fm.time or "--:--"),text_color=fm.ok and C.minute or C.err}
    error_text:set{text=fm.err,text_color=fm.ok and C.soft or C.err}
end
local function run(action)
    if busy then return end
    busy=true
    local ok,result=pcall(native,action)
    fm.time=now()
    fm.ok=ok and result.code>=0
    if fm.ok then
        local active=action==1 or (action==3 and result.handle~=0 and result.advertised~=0)
        if active~=(fm.state=="on") then fm.since=fm.time end
        fm.state=active and "on" or "off"
        fm.err=result.saved and "No errors" or "State save failed"
    else
        if action~=2 then fm.state="err" end
        fm.err=ok and (REASONS[result.code] or "Native error "..result.code)
            or (tostring(result):match(":%d+: (.*)$") or tostring(result)):sub(1,48)
    end
    busy=false
    if type(os.remove)=="function" then
        pcall(os.remove,ROOT.."read.txt");pcall(os.remove,ROOT.."native.txt")
    end
    render()
    return ok and result.code or nil
end
local function set_auto(enabled)
    fm.auto=enabled
    local file=io.open(ROOT.."paused.txt","w")
    if file then file:write(enabled and "0" or "1"); file:close() end
    render()
end
tap(pill,function() open("menu") end)
tap(back,close)
tap(toggle,function()
    local action=fm.state=="on" and 2 or 1
    run(action)
    -- Manual Stop must survive the next face load, manual Start re-arms it
    if fm.ok then set_auto(action==1) end
end)
tap(auto,function() set_auto(not fm.auto) end)

-- Stock Calendar app keeps phone events synced by Mi Fitness ("Events") in UnQLite, key c_data (docs/RESEARCH.md §14)
local CALENDAR_DB="/data/app/calendar/calendar.db"
local function be(data,index,size)
    local value=0
    for k=index,index+size-1 do value=value*256+data:byte(k) end
    return value
end
-- Minimal UnQLite lhash reader: walk every bucket page (and slaves) listed in the bucket map
local function unqlite_get(db,key)
    if db:sub(1,7)~="unqlite" then return nil end
    local size=be(db,20,4)
    local function page(number) return number*size+1 end
    local map,records,count=page(1),page(1)+44,be(db,page(1)+40,4)
    local map_next=be(db,map+32,8)
    while true do
        for n=0,count-1 do
            local bucket=be(db,records+n*16+8,8)
            while bucket~=0 do
                local base=page(bucket)
                local offset=be(db,base,2)
                while offset>0 do
                    local cell=base+offset
                    local key_size,data_size,overflow=be(db,cell+4,4),be(db,cell+8,8),be(db,cell+18,8)
                    if overflow==0 then
                        if db:sub(cell+26,cell+25+key_size)==key and key_size==#key then
                            return db:sub(cell+26+key_size,cell+25+key_size+data_size)
                        end
                    elseif key_size==#key and db:sub(page(overflow)+18,page(overflow)+17+key_size)==key then
                        local first=page(overflow)
                        local data_page,parts=be(db,first+8,8),{}
                        local start,left=page(data_page)+be(db,first+16,2),data_size
                        while left>0 do
                            local chunk=math.min(left,page(data_page)+size-start)
                            parts[#parts+1]=db:sub(start,start+chunk-1)
                            left=left-chunk
                            data_page=be(db,page(data_page),8)
                            start=page(data_page)+8
                        end
                        return table.concat(parts)
                    end
                    offset=be(db,cell+16,2)
                end
                bucket=be(db,base+4,8)
            end
        end
        if map_next==0 then return nil end
        map=page(map_next)
        map_next,count,records=be(db,map,8),be(db,map+8,4),map+12
    end
end
local function protobuf(data,callback)
    local index=1
    local function varint()
        local value,shift,byte=0,0
        repeat byte=data:byte(index); index=index+1; value=value|((byte&0x7f)<<shift); shift=shift+7 until byte<0x80
        return value
    end
    while index<=#data do
        local key=varint()
        local kind,value=key&7
        if kind==0 then value=varint()
        elseif kind==2 then local size=varint(); value=data:sub(index,index+size-1); index=index+size
        elseif kind==5 then index=index+4
        elseif kind==1 then index=index+8
        else error("Bad wire type") end
        callback(key>>3,value)
    end
end
-- CalendarSync{repeated CalendarEvent 1}; CalendarEvent{title 1, start 4, end 5, all_day 6}, epoch seconds
local function upcoming()
    local current,events=os.time(),{}
    local ok,blob=pcall(function() return unqlite_get(read_file(CALENDAR_DB,"a") or "","c_data") end)
    if not (ok and blob) then return events,current end
    pcall(protobuf,blob,function(tag,item)
        if tag~=1 or type(item)~="string" then return end
        local event={title=""}
        protobuf(item,function(field,value)
            if field==1 then event.title=value
            elseif field==4 then event.start=value
            elseif field==5 then event.stop=value
            elseif field==6 then event.all_day=value~=0 end
        end)
        if event.start and event.stop and event.stop>current then events[#events+1]=event end
    end)
    table.sort(events,function(a,b) return a.start<b.start end)
    return events,current
end
local function event_time(event,current)
    if event.start<=current then
        return event.all_day and "TODAY · ALL DAY" or "NOW · until "..os.date("%H:%M",event.stop)
    end
    local day=os.date("%Y%j",event.start)
    local prefix=day==os.date("%Y%j",current) and "TODAY" or day==os.date("%Y%j",current+86400) and "TMRW"
        or os.date("%a %d/%m",event.start):upper()
    return prefix.." · "..(event.all_day and "ALL DAY" or os.date("%H:%M",event.start))
end
local function clip(text,count)
    if text=="" then return "(No title)" end
    -- Firmware Lua has no utf8 library: step over UTF-8 sequences by lead byte
    local index,chars=1,0
    while index<=#text do
        chars=chars+1
        if chars>count then return text:sub(1,index-1).."…" end
        local byte=text:byte(index)
        index=index+(byte>=0xF0 and 4 or byte>=0xE0 and 3 or byte>=0xC0 and 2 or 1)
    end
    return text
end
-- ponytail: re-reads the db every minute; cache by file size if parsing ever shows up as lag
local events_enabled=read_file(ROOT.."events.txt",8)~="0"
local function render_calendar()
    local events,current=upcoming()
    local first=events_enabled and events[1]
    layout(first and true or false)
    menu_events_value:set{text=events_enabled and "ON" or "OFF",text_color=events_enabled and C.minute or C.muted}
    events_track:set{bg_color=events_enabled and C.start or C.track}
    events_knob:set{x=events_enabled and 23 or 3}
    menu_agenda_value:set{text=tostring(#events)}
    events_upcoming_value:set{text=tostring(#events)}
    if first then
        event_when:set{text=event_time(first,current):gsub("^TODAY · ","")}
        event_title:set{text=clip(first.title,30)}
    end
    for index,row in ipairs(agenda_rows) do
        local event=events[index]
        row.when:set{text=event and event_time(event,current) or ""}
        row.title:set{text=event and clip(event.title,15) or (index==1 and "No events" or ""),text_color=event and C.text or C.muted}
    end
end
local function show_agenda() render_calendar(); open("agenda") end
tap(event_card,show_agenda)
tap(agenda_back,close)
tap(menu_fm,function() open("control") end)
tap(menu_events,function() open("events") end)
tap(menu_agenda,show_agenda)
tap(menu_back,close)
tap(events_toggle,function()
    events_enabled=not events_enabled
    local file=io.open(ROOT.."events.txt","w")
    if file then file:write(events_enabled and "1" or "0"); file:close() end
    render_calendar()
end)
tap(events_upcoming,show_agenda)
tap(events_back,close)

-- Metric values arrive as fixed-point x256 per upstream examples
local has_dataman,dataman=pcall(require,"dataman")
if has_dataman then
    -- Firmware publishes 0x7fffffff when weather or heart rate has no data
    local NO_DATA=0x7fffffff
    local function number(value) return math.floor(tonumber(value)/256) end
    local steps,goal=0,0
    local function update_steps()
        local text=tostring(steps):reverse():gsub("(%d%d%d)","%1,"):reverse():gsub("^,","")
        local percent=goal>0 and math.min(100,steps*100//goal) or 0
        steps_text:set{text=text}
        stats.steps:set{text=text}
        steps_pct:set{text=percent.."%"}
        steps_bar:set{w=156*percent//100}
    end
    local function update_date()
        date_text:set{text=string.format("%02d/%02d/%02d",clock.day,clock.month,clock.year%100)}
    end
    -- Fill timestamps of actions that ran before the first time update
    local function stamp()
        if fm.time or not now() then return end
        fm.time=now()
        fm.since=fm.since or fm.time
        render()
    end
    local bindings={
        timeHour=function(v) clock.hour=number(v); hour_text:set{text=string.format("%02d",clock.hour)}; stamp() end,
        timeMinute=function(v) clock.minute=number(v); minute_text:set{text=string.format("%02d",clock.minute)}; stamp(); render_calendar() end,
        dateWeek=function(v) day_text:set{text=({"SUN","MON","TUE","WED","THU","FRI","SAT"})[number(v)%7+1]} end,
        dateDay=function(v) clock.day=number(v); update_date() end,
        dateMonth=function(v) clock.month=number(v); update_date() end,
        dateYear=function(v) clock.year=number(v); update_date() end,
        systemStatusBattery=function(v)
            local level=math.max(0,math.min(100,number(v)))
            battery_text:set{text=tostring(level)}
            battery_fill:set{w=18*level//100}
        end,
        weatherCurrentTemperature=function(v) weather_text:set{text=(v==NO_DATA and "--" or number(v)).."°"} end,
        healthStepCount=function(v) steps=number(v); update_steps() end,
        healthStepTarget=function(v) goal=number(v); update_steps() end,
        healthStepKiloMeter=function(v) stats.km:set{text=string.format("%.1f",v/256)} end,
        healthCalorie=function(v) stats.kcal:set{text=tostring(number(v))} end,
        healthHeartRate=function(v) stats.bpm:set{text=(v~=NO_DATA and number(v)>0) and tostring(number(v)) or "--"} end,
    }
    local owners={timeHour=hour_text,timeMinute=minute_text,dateWeek=day_text,dateDay=date_text,dateMonth=date_text,dateYear=date_text,
        systemStatusBattery=battery_text,weatherCurrentTemperature=weather_text,healthStepCount=steps_text,healthStepTarget=steps_pct,
        healthCalorie=stats.kcal,healthStepKiloMeter=stats.km,healthHeartRate=stats.bpm}
    for name,update in pairs(bindings) do
        dataman.subscribe(name,owners[name],function(_,value) update(value) end)
    end
end

load_state()
fm.auto=read_file(ROOT.."paused.txt",8)~="1"
render()
render_calendar()
-- Bluetooth may come up after the face loads (boot): retry Start a bounded number of times
local retries,retry_timer=0,nil
local function auto_start()
    local code=run(1)
    if not ((code==-10 or code==-11) and fm.auto and retries<10) then return end
    if retry_timer then
        retry_timer:resume()
    else
        -- lvgl.Timer is only proven on Band 9 Pro faces; without it the face keeps the single attempt
        local ok,timer=pcall(lvgl.Timer,{period=3000,cb=function(t)
            t:pause()
            if fm.auto and fm.state~="on" then auto_start() end
        end})
        if not ok then return end
        retry_timer=timer
    end
    retries=retries+1
    fm.err=fm.err.." (retry "..retries.."/10)"
    render()
end
if fm.auto then auto_start() else run(3) end
