local expected_address = __DEVICE_ADDRESS_BYTES__
local address_text = __PUBLIC_ADDRESS_TEXT__
local state = { handle = 0, id = 0 }
local busy = false
local firmware_ok = false

local function read_file(path, count)
    local file = io.open(path, "r")
    if not file then return nil end
    local content = file:read(count or 2048)
    file:close()
    return content
end
local function load_state()
    local text = read_file(ROOT .. "beacon-state.txt", 128)
        or read_file("/data/app/watchface/market/975903279/lua/beacon-state.txt",128)
        or read_file("/data/app/watchface/market/975903278/lua/beacon-state.txt",128)
        or read_file("/data/app/watchface/market/975903277/lua/beacon-state.txt",128)
        or read_file("/data/app/watchface/market/975903276/lua/beacon-state.txt",128) or ""
    local handle, id = text:match("^(%x+)%s+(%x+)")
    if handle and id then state.handle = tonumber(handle,16); state.id = tonumber(id,16) end
end
local function save_state()
    local file = io.open(ROOT .. "beacon-state.txt", "w")
    if not file then return false end
    local ok = file:write(string.format("%08x %08x\n",state.handle,state.id))
    file:close()
    return ok ~= nil
end
local function command(address)
    local ok, status = pcall(os.execute,string.format("exec 0x%08x > %snative.txt",address,ROOT))
    return ok and (status == true or status == 0)
end
local function words(address,count)
    assert(address % 4 == 0 and count >= 1 and count <= 32,"Invalid read")
    local ok,status = pcall(os.execute,string.format("mw %08x %x > %sread.txt",address,count*4,ROOT))
    assert(ok and (status==true or status==0),"Memory read failed")
    local text = read_file(ROOT .. "read.txt",4096) or ""
    local result={}
    for value in text:gmatch("=%s*0[xX](%x+)") do result[#result+1]=tonumber(value,16) end
    assert(#result==count,"Memory output mismatch")
    return result
end
local function in_psram(address,size)
    return address and address%4==0 and address>=0x3c800000 and address+size<0x3d000000
end
local function firmware_check()
    local properties = read_file("/etc/build.prop",16384) or ""
    local version
    for line in (properties.."\n"):gmatch("(.-)\n") do
        local key,value=line:match("^%s*([^=#%s]+)%s*=%s*(.-)%s*$")
        if key=="ro.build.version" then version=value end
    end
    assert(version=="2.3.98","Requires firmware 2.3.98")
    for _,item in ipairs(fingerprints) do
        local actual=words(item[1],4)
        for index,expected in ipairs(item[2]) do assert(actual[index]==expected,"Firmware mismatch") end
    end
    assert(words(0xe000ed94,1)[1]==5,"Unexpected MPU state")
    assert((words(0x07ffa000,1)[1]&1)==1 and (words(0x07ffc000,1)[1]&1)==1,"Cache disabled")
end
local function signed(value)
    return value>=0x80000000 and value-0x100000000 or value
end
local function native(action,test_mode)
    local packet=test_mode and payload:sub(1,2)..string.char(0xff,0xff)..payload:sub(5) or payload
    if not firmware_ok then firmware_check(); firmware_ok=true end
    local prefix=string.pack("<i4I4I4I4I4i4i4i4",0x7ffffffe,action,state.handle,state.id,0,-999,-999,-999)
        ..random_address..string.rep("\0",2)..packet.."\0"..string.rep("\0",8)
        ..expected_address..string.rep("\0",2)..string.pack("<I4I4i4",0,0,-999)..string.rep("\0",28)
    assert(#prefix==128,"Mailbox size mismatch")
    local function retain(value) return function() return value end end
    -- The allocator sometimes places the buffer outside the executable PSRAM window: collect, then retry holding rejects
    collectgarbage("collect")
    local owner,object,rejected,last
    for _=1,5 do
        owner=retain(prefix..native_code..string.rep("\0",32))
        local upvalue=tonumber(tostring(debug.upvalueid(owner,1)):match("0[xX](%x+)$") or "",16)
        last=upvalue or 0
        if in_psram(upvalue,32) then
            local value_pointer=words(upvalue+8,1)[1]
            assert(value_pointer==upvalue+16,"Upvalue layout mismatch")
            local value=words(value_pointer,3)
            assert((value[3]&0xff)==0x54,"Long string tag mismatch")
            last=value[1]
            if in_psram(last,#owner()+16) then object=last; break end
        end
        rejected={owner,rejected}
    end
    assert(object,string.format("Buffer outside PSRAM 0x%08x",last))
    local header=words(object,4)
    assert((header[2]&0xff)==0x14 and header[4]==#owner(),"String layout mismatch")
    local mailbox=object+16
    local executable=mailbox+128-0x20000000
    assert(command(0x0c514c55),"D-cache sync failed")
    assert(command(0x0c10d3c7),"Cache barrier failed")
    assert(command(0x0c101683),"I-cache sync failed")
    assert(command(0x0c10d3c7),"Instruction barrier failed")
    local direct=words(mailbox+128,4)
    local alias=words(executable,4)
    for index=1,4 do
        local expected=string.unpack("<I4",native_code,(index-1)*4+1)
        assert(direct[index]==expected,"Buffer code differs")
        assert(alias[index]==expected,string.format("Alias %d: %08x != %08x",index,alias[index],expected))
    end
    local shell_ok=command(executable|1)
    local result=words(mailbox,32)
    assert(#owner()>128,"Owner lifetime mismatch")
    assert(result[1]~=0x7ffffffe,"Native result missing")
    state.handle=result[3]
    state.id=result[4]
    local saved=save_state()
    local code=signed(result[1])
    local raw={}
    for index=19,20 do
        local bytes=string.pack("<I4",result[index])
        for j=1,#bytes do raw[#raw+1]=string.format("%02X",bytes:byte(j)) end
    end
    return {code=code,handle=state.handle,id=state.id,flags=result[5],
        registered=signed(result[6]),started=signed(result[7]),stopped=signed(result[8]),
        clients=result[23],advertised=result[24],unregistered=signed(result[25]),
        local_address=table.concat(raw,":",1,6),saved=saved,shell_ok=shell_ok}
end
local REASONS={[-10]="Bluetooth not ready",[-11]="Stock client unavailable",[-13]="Registration failed",[-14]="Address query failed",[-15]="Device address differs",[-16]="Advertising rejected",[-17]="Stop rejected",[-18]="Client release failed"}
local C={text="#FAF3E7",muted="#9A9382",soft="#C9C1AE",card="#1C1A11",minute="#6EE7B7",cyan="#67D4E8",lime="#C4E86B",err="#FF7A7A",stop="#D9465A",start="#1F9D63",track="#3A3524",dark="#221F13",line="#2A2617",km="#93C5FD",kcal="#FDA4AF",bpm="#AC96D4"}
local FM_COLOR={on=C.minute,off=C.muted,err=C.err}
-- ponytail: y offsets are guesses for MiSans line boxes; tune on device
-- No event: design 4a (134 px clock, step bar, kcal/km/bpm); event: 108 px clock, card, steps/kcal/bpm row
local LAYOUTS={
    [false]={clock=134,clock_y=22,step=112,date=282,stats=364,columns={kcal={12,56},km={68,56},bpm={124,56}}},
    [true]={clock=108,clock_y=29,step=90,date=242,card=268,stats=366,columns={steps={10,76},kcal={86,48},bpm={134,48}}},
}
-- Firmware exposes the text_align style but no lvgl.TEXT_ALIGN table; use LV_TEXT_ALIGN values
local CENTER,RIGHT=2,3
local fm={state="off",auto=true,ok=true,err="No errors"}
local clock={day=1,month=1,year=0}

local root=lvgl.Object(nil,{w=lvgl.HOR_RES(),h=lvgl.VER_RES(),bg_color=0,bg_opa=lvgl.OPA(100),border_width=0,pad_all=0})
root:clear_flag(lvgl.FLAG.SCROLLABLE)
root:add_flag(lvgl.FLAG.EVENT_BUBBLE)
local function box(parent,x,y,w,h,color,radius,extra)
    local props={x=x,y=y,w=w,h=h,bg_color=color or 0,bg_opa=lvgl.OPA(color and 100 or 0),border_width=0,pad_all=0,radius=radius or 0}
    for key,value in pairs(extra or {}) do props[key]=value end
    local object=lvgl.Object(parent,props)
    object:clear_flag(lvgl.FLAG.SCROLLABLE)
    object:add_flag(lvgl.FLAG.EVENT_BUBBLE)
    return object
end
-- Reuse one font object per face/size; screen 2 only uses sizes already loaded by screen 1
local fonts={}
local function font(weight,size)
    local name="MiSans-"..(weight or "Regular")
    local key=name..size
    fonts[key]=fonts[key] or lvgl.Font(name,size)
    return fonts[key]
end
local function label(parent,text,x,y,w,h,size,color,weight,align)
    local object=lvgl.Label(parent,{text=text,x=x,y=y,w=w,h=h,text_color=color or C.text,text_align=align,
        text_font=font(weight,size)})
    object:add_flag(lvgl.FLAG.EVENT_BUBBLE)
    return object
end
local function tap(object,action)
    object:clear_flag(lvgl.FLAG.EVENT_BUBBLE)
    object:add_flag(lvgl.FLAG.CLICKABLE)
    object:onevent(lvgl.EVENT.CLICKED,action)
end
local function show(object,visible)
    if visible then object:clear_flag(lvgl.FLAG.HIDDEN) else object:add_flag(lvgl.FLAG.HIDDEN) end
end

-- Screen 1: everyday face
