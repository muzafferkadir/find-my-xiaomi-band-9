{0x2c3c8f3c,{0xaf00b580,0x6883b170,0x6f5bb11b,0x4798b10b}},
{0x2c164cdc,{0xb088b5b0,0xaf004605,0x2400b198,0x0110f107}},
{0x2c3c032c,{0x41f0e92d,0xaf006808,0x4616460d,0xff9af7ff}},
