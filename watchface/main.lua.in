local fingerprints = {{0x2c100000,{0xffffffff,0x00050000,0x00000000,0x28732880}},
{0x2c1b3b24,{0xb083b5f0,0xaf004616,0x22004604,0x1d396870}},
{0x2c1b8268,{0x4ff0e92d,0x4605b083,0x68504688,0xaf00213d}},
{0x2c3c68c8,{0x47f0e92d,0x4606b090,0xaf02460c,0xf0002900}},
