{0x2c1c7ab0,{0x4604b5f8,0xaf00460e,0x46154915,0xf7ee4a15}},
{0x2c514c54,{0xe7f94b01,0x07ffc000,0x07ffa000,0xd1112804}},
{0x2c101680,{0x4b07d109,0xf012681a,0xf04f0f01,0xbf0a0201}},
{0x2c10d3c4,{0xf3bf2094,0xf3bf8f4f,0x47708f6f,0x2006b380}},
{0x2c3c7d94,{0xb083b5f0,0xaf004604,0x460e200c,0xf5a04615}},
