local steps_text=label(main,"--",18,314,110,34,28,C.lime,"Demibold")
local steps_pct=label(main,"--%",120,324,54,18,13,C.muted,"Regular",RIGHT)
local steps_track=box(main,18,350,156,5,C.line,3)
local steps_bar=box(main,18,350,0,5,C.lime,3)
local stats,stat_units={},{}
for _,item in ipairs({{"steps",C.lime},{"kcal",C.kcal},{"km",C.km},{"bpm",C.bpm}}) do
    stats[item[1]]=label(main,"--",0,0,56,28,22,item[2],"Demibold",CENTER)
    stat_units[item[1]]=label(main,item[1],0,0,56,18,13,C.muted,"Regular",CENTER)
end
local pill=box(main,40,418,112,44,C.card,22,{border_width=2})
local pill_dot=box(pill,30,18,8,8,C.minute,4)
label(pill,"MENU",46,10,56,22,15,C.text,"Medium")
local layout_event
local function layout(has_event)
    if layout_event==has_event then return end
    layout_event=has_event
    local l=LAYOUTS[has_event]
    hour_text:set{y=l.clock_y,h=l.step+40,text_font=font("Demibold",l.clock)}
    minute_text:set{y=l.clock_y+l.step,h=l.step+40,text_font=font("Demibold",l.clock)}
    day_text:set{y=l.date}
    date_text:set{y=l.date}
    if has_event then event_card:set{y=l.card} end
    show(event_card,has_event)
    for _,object in ipairs({steps_text,steps_pct,steps_track,steps_bar}) do show(object,not has_event) end
    for name,value in pairs(stats) do
        local column=l.columns[name]
        show(value,column~=nil)
        show(stat_units[name],column~=nil)
        if column then
            value:set{x=column[1],w=column[2],y=l.stats}
            stat_units[name]:set{x=column[1],w=column[2],y=l.stats+28}
        end
    end
end
layout(false)

