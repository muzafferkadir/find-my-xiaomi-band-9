-- Settings rows: name on the left, live value on the right
local function row(parent,y,name)
    local object=box(parent,14,y,164,60,C.card,22)
    label(object,name,16,18,110,24,17,C.text,"Demibold")
    return object,label(object,"",96,20,52,20,15,C.muted,"Medium",RIGHT)
end
local function switch(parent,x,y)
    local track=box(parent,x,y,48,28,C.track,14)
    return track,box(track,3,3,22,22,C.text,11)
end

